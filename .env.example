# PostgreSQL (Coolify: připoj DATABASE_URL z Postgres služby)
DATABASE_URL=postgres://fakturujto:fakturujto@localhost:5432/fakturujto

# JWT signing secret (min. 16 znaků) — v produkci vždy změň
JWT_SECRET=change-me-in-production-min-16-chars

# API
PORT=3001
# Jedna URL, * , nebo čárkou oddělené origin (web + tauri)
CORS_ORIGIN=http://localhost:1420

# Frontend (Vite build na Coolify): veřejná URL API
# VITE_API_URL=https://api.your-domain.tld
