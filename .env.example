# PostgreSQL (Coolify: připoj DATABASE_URL z Postgres služby)
DATABASE_URL=postgres://fakturujto:fakturujto@localhost:5432/fakturujto

# JWT signing secret (min. 16 znaků) — v produkci vždy změň
JWT_SECRET=change-me-in-production-min-16-chars

# API / unified app
PORT=3001
# Jedna URL, * , nebo čárkou oddělené origin
CORS_ORIGIN=*

# Coolify: nasaď root Dockerfile (frontend + API v jednom kontejneru).
# Doména fakturujto.virtuex.cz musí mířit na TUTO službu (ne na čistý static hosting).
# VITE_API_URL nech prázdné — frontend volá same-origin /api/...
